{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/zona-de-risco.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/aprovacao-em-raio-alto.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/caracterizacao-antes.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/orcamento-de-mudanca.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/raio-antes-do-plano.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/reversao-declarada.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/legadox/sem-colateral.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
